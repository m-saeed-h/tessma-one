// Tessma One — data model for the foundation slice.
// Every business table carries tenantId and is protected by row-level security
// (see prisma/rls.sql). Money is stored as integer minor units (pence) — never
// floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Core: partner tier --------------------------------------------------------
// Charter §7.9: the partner entity, partner_id on tenant, and the branding
// resolution chain must exist in the Phase 1 core even though no partner-facing
// UI is built until Phase 3 — adding a hierarchy level after tenants hold live
// financial data is a migration nobody wants to run. Partner itself is owned by
// the Platform Operator, not by a tenant, so it carries no tenantId.

model Partner {
  id                   String   @id @default(uuid())
  name                 String
  brandName            String?
  logoUrl              String?
  // The only two tokens a white-label theme actually swaps (design system
  // rule: "white-label swaps --primary and --accent only; structure never
  // changes") — primary drives actions/links, accent is the one signature
  // brand moment (e.g. the sidebar mark). Everything else the UI renders
  // (ink, slate, paper, surface, line, semantic success/warning/danger) is a
  // fixed platform token, not brand-configurable.
  primaryColor         String?
  accentColor          String?
  supportUrl           String?
  senderDomain         String?
  senderDomainVerified Boolean  @default(false)
  createdAt            DateTime @default(now())

  tenants              Tenant[]
}

// ---- Core: tenancy & identity -------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  // partnerId is here from day one even though partner features come later,
  // because adding a hierarchy level after live financial data is a painful migration.
  partnerId String?
  createdAt DateTime @default(now())

  partner       Partner?         @relation(fields: [partnerId], references: [id])
  users         User[]
  branding      TenantBranding?
  subscription  TenantSubscription?
  financeProfile TenantFinanceProfile?
}

// FR-SET-007/009/010 (partial): the tenant's own legal/VAT identity, needed
// to put a legally compliant seller block on an invoice PDF (FR-SIN-009).
// Everything else in EP-FIN-01 (financial year, accounting basis, period
// locking, configurable numbering formats) is a materially larger epic and
// is NOT covered by this model — see README.
model TenantFinanceProfile {
  tenantId                String  @id
  legalName               String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  postcode                String?
  country                 String? @default("GB")
  vatNumber               String?
  companyNumber           String?
  footerText              String?
  defaultPaymentTermsDays Int     @default(30)

  tenant                  Tenant  @relation(fields: [tenantId], references: [id])
}

// Tenant-level branding override — the top of the resolution chain
// (tenant override -> partner theme -> platform default). See branding.service.ts.
model TenantBranding {
  tenantId     String  @id
  productName  String?
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  supportUrl   String?

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]

  // Email is globally unique, not just per tenant: this model gives each user
  // exactly one tenant (User.tenantId is a single FK, not a membership table),
  // so allowing the same email under two tenants let login's by-email lookup
  // silently resolve to an arbitrary tenant. Fixed at the schema level, not
  // just in application code, so it can't regress.
  @@unique([email])
  @@index([tenantId])
}

// ---- Core: RBAC ----------------------------------------------------------------
// Permissions are strings shaped module.resource.action (see Engineering Standards).
// Roles are data, not code; system roles are seeded and marked isSystem.

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String                     // OWNER | FINANCE_MANAGER | ACCOUNTANT ...
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  id         String @id @default(uuid())
  tenantId   String
  roleId     String
  permission String                       // e.g. "finance.invoice.issue"

  role       Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, roleId, permission])
  @@index([tenantId])
}

model UserRole {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  roleId   String

  user     User @relation(fields: [userId], references: [id])
  role     Role @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
}

// ---- Core: subscriptions & entitlements ----------------------------------------
// Charter §6.4: tenants subscribe to plans; plans grant entitlements to modules
// and features; entitlement is verified server-side on every gated request.
// Plan/PlanFeature are a Platform-Operator-owned catalogue (no tenantId) —
// analogous to Partner, they describe the platform, not one tenant's data.

model Plan {
  id       String  @id @default(uuid())
  code     String  @unique // e.g. "TRIAL", "STARTER"
  name     String

  features     PlanFeature[]
  subscriptions TenantSubscription[]
}

model PlanFeature {
  id         String @id @default(uuid())
  planId     String
  featureKey String // e.g. "finance", "finance.ai.assistant"

  plan       Plan   @relation(fields: [planId], references: [id])

  @@unique([planId, featureKey])
}

model TenantSubscription {
  tenantId  String   @id
  planId    String
  status    String   @default("TRIALING") // TRIALING | ACTIVE | CANCELLED
  // AI safety rule 12: "A tenant administrator can disable AI features
  // entirely, per module, without loss of core functionality." Per-module
  // granularity is a Stage 3+ concern (there's only one AI-touching module
  // so far); the tenant-wide switch is the Stage 1 primitive it builds on.
  aiEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

// ---- Core: shared Party master -----------------------------------------------
// A customer/supplier/etc is a ROLE on a Party, not its own table (Charter
// §2.2: "Finance must consume the shared Party service even though, in
// Phase 1, Finance is the only consumer"). FR-PTY-002/003/004/005.

model Party {
  id            String   @id @default(uuid())
  tenantId      String
  type          String   // COMPANY | INDIVIDUAL
  legalName     String
  tradingName   String?
  companyNumber String?
  vatNumber     String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  postcode      String?
  country       String?  @default("GB")
  notes         String?
  createdAt     DateTime @default(now())

  customer      CustomerRole?
  supplier      SupplierRole?
  invoices      Invoice[]
  quotations    Quotation[]
  creditNotes   CreditNote[]
  payments      Payment[]

  @@index([tenantId])
}

model CustomerRole {
  id                   String  @id @default(uuid())
  tenantId             String
  partyId              String  @unique
  // Null means "not set for this customer" — falls back to the tenant's own
  // FR-SET-009 organisation-level default (TenantFinanceProfile), not a
  // hard-coded 30, so that default is actually reachable. See finance.service.ts's issue().
  paymentTerms         Int?    // days
  creditLimit          BigInt  @default(0)  // pence, 0 = no limit enforced
  // FR-PTY-011: behaviour on credit-limit breach is tenant configuration —
  // WARN lets the invoice proceed with a flagged response, BLOCK refuses it.
  creditLimitBehaviour String  @default("WARN") // WARN | BLOCK

  party                Party   @relation(fields: [partyId], references: [id])

  @@index([tenantId])
}

// FR-PTY-013/014: supplier bank details are the highest-sensitivity Party
// field (SEC-DAT-03 names "bank account details" explicitly) — encrypted at
// the application level via shared/crypto/field-encryption.ts, so a database
// compromise alone does not disclose them. A change requires re-auth and
// raises a high-severity audit event (see suppliers.service.ts).
model SupplierRole {
  id                   String    @id @default(uuid())
  tenantId             String
  partyId              String    @unique
  paymentTerms         Int?      // days; null means "not set for this supplier"
  bankAccountNameEnc   String?
  bankSortCodeEnc      String?
  bankAccountNumberEnc String?
  bankDetailsUpdatedAt DateTime?

  party                Party     @relation(fields: [partyId], references: [id])

  @@index([tenantId])
}

// ---- Finance: products, chart of accounts, invoices, ledger ------------------
// FR-PRD-001 to 006.

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  sku           String
  type          String   @default("SERVICE") // PRODUCT | SERVICE
  name          String
  description   String?
  unit          String   @default("each")
  unitPrice     BigInt   // sales price, pence, VAT-exclusive
  purchasePrice BigInt?  // pence, VAT-exclusive
  vatRatePct    Int      @default(20)
  vatTreatment  String   @default("STANDARD") // STANDARD | REDUCED | ZERO | EXEMPT | OUTSIDE_SCOPE
  status        String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime @default(now())

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Account {
  id        String @id @default(uuid())
  tenantId  String
  code      String // e.g. "1100" debtors, "4000" revenue, "2200" output VAT
  name      String
  type      String // ASSET | LIABILITY | INCOME | EXPENSE | EQUITY

  entries   LedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Invoice {
  id                String    @id @default(uuid())
  tenantId          String
  partyId           String
  number            String?   // allocated at ISSUE, not while DRAFT
  // FR-SIN-006: DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED | WRITTEN_OFF.
  // (AWAITING_APPROVAL/APPROVED/SENT/VIEWED/OVERDUE need approval routing,
  // outbound email and a scheduled job respectively — genuinely not built in
  // this pass; see README.)
  status            String    @default("DRAFT")
  issueDate         DateTime?
  dueDate           DateTime?
  supplyDate        DateTime?
  purchaseOrderRef  String?
  notes             String?
  terms             String?
  currency          String    @default("GBP")
  netTotal          BigInt    @default(0) // pence
  vatTotal          BigInt    @default(0)
  grossTotal        BigInt    @default(0)
  // Denormalised running total of payment + credit-note allocations, kept in
  // lockstep by payments.service.ts / credit-notes.service.ts inside the same
  // transaction as the allocation write — never computed ad hoc, so it can
  // never drift from the allocation rows it summarises.
  allocatedTotal    BigInt    @default(0)
  cancelledReason   String?
  cancelledAt       DateTime?
  sourceQuotationId String?
  createdAt         DateTime  @default(now())

  party         Party               @relation(fields: [partyId], references: [id])
  lines         InvoiceLine[]
  ledgerEntries LedgerEntry[]
  creditNotes   CreditNote[]
  allocations   PaymentAllocation[]
  deliveries    InvoiceDelivery[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

// FR-SIN-010/011/012: a record of each time an invoice was emailed to a
// customer. `status` is SENT|FAILED only — DELIVERED/OPENED/BOUNCED need a
// real ESP's webhook events and aren't reachable through the dev-mode
// transport, the same honest gap as SMS/PUSH in notifications.service.ts.
model InvoiceDelivery {
  id           String   @id @default(uuid())
  tenantId     String
  invoiceId    String
  sentByUserId String
  to           String[]
  cc           String[] @default([])
  bcc          String[] @default([])
  subject      String
  body         String
  status       String   @default("SENT")
  createdAt    DateTime @default(now())

  invoice      Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, invoiceId])
}

model InvoiceLine {
  id          String @id @default(uuid())
  tenantId    String
  invoiceId   String
  description String
  quantity    Int
  unitPrice   BigInt // pence
  discountPct Int    @default(0)
  vatRatePct  Int    @default(20)
  net         BigInt // pence, computed
  vat         BigInt
  total       BigInt

  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
}

// FR-QUO-001 to 004.
model Quotation {
  id         String    @id @default(uuid())
  tenantId   String
  partyId    String
  number     String?
  status     String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED
  expiryDate DateTime?
  netTotal   BigInt    @default(0)
  vatTotal   BigInt    @default(0)
  grossTotal BigInt    @default(0)
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  party Party           @relation(fields: [partyId], references: [id])
  lines QuotationLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model QuotationLine {
  id          String @id @default(uuid())
  tenantId    String
  quotationId String
  description String
  quantity    Int
  unitPrice   BigInt
  discountPct Int    @default(0)
  vatRatePct  Int    @default(20)
  net         BigInt
  vat         BigInt
  total       BigInt

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([tenantId])
}

// FR-CRN-001 to 008: full, partial or line-level credit against an invoice,
// or a standalone credit (invoiceId null) held on account. Always posts a
// reversing ledger entry — never edits the original invoice's postings
// (BR-FIN-04).
model CreditNote {
  id             String    @id @default(uuid())
  tenantId       String
  partyId        String
  invoiceId      String?
  number         String?
  status         String    @default("DRAFT") // DRAFT | ISSUED
  reasonCode     String    // RETURN | PRICING_ERROR | GOODWILL | BAD_DEBT | OTHER
  reasonText     String
  netTotal       BigInt    @default(0)
  vatTotal       BigInt    @default(0)
  grossTotal     BigInt    @default(0)
  // How much of this credit has been applied to an invoice (or refunded) —
  // grossTotal - allocatedTotal is what's left as unallocated credit on account.
  allocatedTotal BigInt    @default(0)
  issueDate      DateTime?
  createdAt      DateTime  @default(now())

  party         Party         @relation(fields: [partyId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  lines         CreditNoteLine[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model CreditNoteLine {
  id           String @id @default(uuid())
  tenantId     String
  creditNoteId String
  description  String
  quantity     Int
  unitPrice    BigInt
  vatRatePct   Int    @default(20)
  net          BigInt
  vat          BigInt
  total        BigInt

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])

  @@index([tenantId])
}

// FR-ARC-003 to 006: a receipt recorded against a party, allocated across
// one or more invoices (partial or multiple), with any unallocated remainder
// held on account for later allocation.
model Payment {
  id           String   @id @default(uuid())
  tenantId     String
  partyId      String
  method       String   // BANK_TRANSFER | CARD | CASH | OTHER
  reference    String?
  amount       BigInt   // pence, total received
  unallocated  BigInt   // pence remaining to allocate
  receivedDate DateTime @default(now())
  createdAt    DateTime @default(now())

  party         Party               @relation(fields: [partyId], references: [id])
  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]

  @@index([tenantId])
}

model PaymentAllocation {
  id        String @id @default(uuid())
  tenantId  String
  paymentId String
  invoiceId String
  amount    BigInt // pence allocated to this invoice

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
}

model LedgerEntry {
  id           String      @id @default(uuid())
  tenantId     String
  accountId    String
  invoiceId    String?
  creditNoteId String?
  paymentId    String?
  debit        BigInt      @default(0) // pence
  credit       BigInt      @default(0)
  narrative    String
  postedAt     DateTime    @default(now())

  account    Account     @relation(fields: [accountId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])
  payment    Payment?    @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
}

// ---- Core: audit -------------------------------------------------------------
// Append-only by grant (see rls.sql: UPDATE/DELETE are revoked from the app
// role on this table) — the database is the layer that survives an application
// bug, per Charter §6.2 "defence in depth".

model AuditEvent {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  // Charter §7.7 / FR-PTN-017: audit must distinguish a tenant user from a
  // partner user under standing service access or under time-boxed support
  // elevation. No partner-user actors exist yet in this slice (partner console
  // is Phase 3), so this is always TENANT_USER today — but the column exists
  // now so a future partner-access feature never needs a migration against
  // live audit history.
  actorType     String   @default("TENANT_USER") // TENANT_USER | PARTNER_STANDING | PARTNER_ELEVATION | SYSTEM
  action        String   // e.g. "invoice.issued"
  resourceType  String
  resourceId    String
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

// Per-tenant, per-type document number counter (safe under concurrency via
// an atomic UPDATE ... RETURNING in code).
model NumberSequence {
  tenantId  String
  docType   String
  next      Int    @default(1)

  @@id([tenantId, docType])
}

// ---- Platform: documents -------------------------------------------------------
// Charter §5.2 platform/documents: "object storage abstraction, metadata,
// versions." The API never touches file bytes (SEC-APP-06 / Build Guide §5:
// "never save files onto the server's own disk") — this row is metadata plus
// a storage key; the bytes live in S3-compatible object storage (MinIO in
// dev) behind short-lived signed URLs (documents.service.ts).

model Document {
  id               String   @id @default(uuid())
  tenantId         String
  resourceType     String   // what this file is attached to, e.g. "Invoice", "Expense"
  resourceId       String
  filename         String
  mimeType         String
  sizeBytes        BigInt   @default(0)
  storageKey       String   @unique // namespaced by tenant within the bucket
  checksum         String?  // sha256, recorded once the upload is confirmed
  status           String   @default("PENDING") // PENDING | UPLOADED | REJECTED
  // SEC-DAT-05: Public | Internal | Confidential | Restricted.
  classification   String   @default("Internal")
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, resourceType, resourceId])
}

// ---- Platform: notifications ----------------------------------------------------
// Charter §5.2 platform/notifications: "in-app, email, push, SMS channels."
// Channel delivery is provider-abstracted (notifications.service.ts); only
// in-app and a dev-mode email transport are wired to a real transport in this
// slice, but every channel goes through the same interface and the same row
// shape, so adding a real SMS/push provider later is a provider swap, not a
// redesign.

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  channel   String    // IN_APP | EMAIL | SMS | PUSH
  subject   String
  body      String
  status    String    @default("SENT") // SENT | READ | FAILED
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, userId])
}

// ---- Platform: workflow / approvals ---------------------------------------------
// Charter §5.2 platform/workflow: "reusable approval and state machine
// engine." FR-APR-009: "Finance approvals shall be implemented on the shared
// platform workflow engine and shall not be re-implemented within the
// Finance module" — so this is deliberately generic (subjectType is a string
// like "finance.expense", not a Finance-specific table), ready for Stage 2's
// expense claims and payment runs to submit into without any change here.

model ApprovalRule {
  id          String   @id @default(uuid())
  tenantId    String
  subjectType String   // e.g. "finance.expense", "finance.payment_run"
  minAmount   BigInt?  // pence; rule applies once subject amount >= this (null = always)
  steps       Json     // [{ sequence: 1, approverRole: "FINANCE_MANAGER" }, ...]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@unique([tenantId, subjectType])
}

model ApprovalRequest {
  id                String    @id @default(uuid())
  tenantId          String
  subjectType       String
  subjectId         String
  submittedByUserId String
  amount            BigInt?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  currentStep       Int       @default(1)
  createdAt         DateTime  @default(now())
  decidedAt         DateTime?

  decisions         ApprovalDecision[]

  @@index([tenantId])
  @@unique([tenantId, subjectType, subjectId])
}

// Append-only (see rls.sql): FR-APR-005 records approval/rejection with actor
// and timestamp — a decision, once made, is not editable, the same principle
// as an audit event.
model ApprovalDecision {
  id         String   @id @default(uuid())
  tenantId   String
  requestId  String
  step       Int
  approverId String
  decision   String   // APPROVED | REJECTED
  comment    String?
  decidedAt  DateTime @default(now())

  request    ApprovalRequest @relation(fields: [requestId], references: [id])

  @@index([tenantId])
}

// ---- Platform: AI Gateway --------------------------------------------------------
// Charter §9.1: every module calls the internal AI Gateway, never a provider
// directly. AI safety rule 11: "Every agent action is logged with inputs,
// model, prompt version, output, confidence and the resulting business
// action" — this table is that log. The provider behind the gateway is
// pluggable (ai-gateway.service.ts); Stage 1 ships a deterministic
// no-network "null" provider so the plumbing (redaction, metering, audit,
// the per-tenant kill switch) is provably correct without depending on an
// external API key existing in every dev/CI environment.
model AiUsageEvent {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  task          String   // e.g. "document_extraction", "collections_draft"
  provider      String   // e.g. "null-dev", a real provider name later
  promptVersion String
  redacted      Boolean  @default(false)
  confidence    Float?
  createdAt     DateTime @default(now())

  @@index([tenantId])
}
