# Copy to .env before running.
DATABASE_URL="postgresql://tessma:tessma@localhost:5432/tessma?schema=public"
# The DB role the APP connects as. It must NOT be the table owner and must NOT
# be a superuser, otherwise PostgreSQL row-level security is bypassed silently.
APP_DATABASE_URL="postgresql://tessma_app:tessma_app@localhost:5432/tessma?schema=public"
JWT_SECRET="change-me-in-production-please"
# SEC-DAT-03: encrypts supplier bank details at the application level.
# Distinct from JWT_SECRET on purpose — a leaked session secret shouldn't
# also unlock encrypted bank details. Must be exactly 32 bytes, base64-encoded
# (AES-256 requires it) — this is the dev-only default field-encryption.ts
# falls back to anyway; change it for any environment holding real data.
FIELD_ENCRYPTION_KEY="ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXkhISE="
PORT=4000

# Object storage (documents platform service). Both point at the same MinIO
# instance for non-Docker local dev — docker-compose.yml overrides these to
# split internal (compose network) vs. public (host-published) endpoints; see
# S3Service's class comment for why that split exists.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="tessma"
S3_SECRET_KEY="tessma12345"
S3_BUCKET="tessma-documents"

# Read by the Next.js SERVER's branding resolution (apps/web/app/layout.tsx),
# not the browser. Only needed running apps/web outside Docker.
API_INTERNAL_URL="http://localhost:4000"

# Optional. Unset (the default) means invoice emails go to the console-log
# transport (ConsoleInvoiceEmailProvider) — fine for local dev/CI. Set both to
# switch the FR-SIN-010 "email invoice to customer" flow to Resend's API for
# real delivery (see modules/finance/pdf/resend-invoice-email.provider.ts).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="invoices@yourdomain.com"
